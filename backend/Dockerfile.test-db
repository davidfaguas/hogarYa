# ==============================================================================
# Dockerfile para Base de Datos de Prueba: PostgreSQL 16 + PostGIS 3.4 + pgvector
# Resuelve Defecto 2: postgis/postgis:16-3.4 no incluye la extensión pgvector
# ==============================================================================
FROM postgis/postgis:16-3.4

LABEL maintainer="HogarYa Platform Architecture <arquitectura@hogarya.cl>"
LABEL description="PostgreSQL 16 oficial con extensiones PostGIS 3.4 y pgvector 0.7 precompiladas"

# Instalar el paquete de extensión postgresql-16-pgvector de los repositorios de Debian
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-16-pgvector \
    && rm -rf /var/lib/apt/lists/*

# Verificar la presencia de los archivos de control de ambas extensiones durante el build
RUN ls -l /usr/share/postgresql/16/extension/postgis.control && \
    ls -l /usr/share/postgresql/16/extension/vector.control

USER postgres
EXPOSE 5432
CMD ["postgres"]
